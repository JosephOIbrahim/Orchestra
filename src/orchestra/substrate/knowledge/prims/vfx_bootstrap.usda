#usda 1.0
(
    doc = """
    VFX Knowledge Bootstrap - Manually Curated Knowledge Prims

    75 knowledge prims for Persistent State Hypothesis testing.
    Distribution: 25 USD, 25 Houdini, 15 Karma, 10 Pipeline
    """
    customLayerData = {
        string version = "1.0.0"
        string created = "2026-01-21"
        int prim_count = 75
        float confidence = 0.95
    }
)

def "Knowledge" (
    kind = "assembly"
)
{
    # ═══════════════════════════════════════════════════════════════════
    # USD CONCEPTS (25 prims)
    # ═══════════════════════════════════════════════════════════════════

    def "USD" {
        def "LIVRPS" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/LIVRPS"
            custom string content = """LIVRPS is the composition arc strength ordering in USD: Local, Inherits, VariantSets, References, Payloads, Specializes. Stronger arcs override weaker ones. Local opinions (direct attribute values) are strongest. Specializes is weakest, providing base definitions. This ordering is deterministic and enables predictable override behavior in complex scene graphs."""
            custom string summary = "USD composition arc priority ordering: Local > Inherits > VariantSets > References > Payloads > Specializes"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx", "composition"]
            custom string[] requires = []
            custom string[] enables = ["/Knowledge/USD/Composition", "/Knowledge/USD/Reference", "/Knowledge/USD/Payload"]
            custom string[] related_to = ["/Knowledge/USD/Opinion", "/Knowledge/USD/LayerStack"]
            custom string teaching_altitude = "15000ft"
            custom string[] key_concepts = ["Composition ordering", "Override strength", "Deterministic resolution"]
            custom string[] triggers = ["livrps", "composition order", "arc strength", "override priority"]
        }

        def "Composition" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Composition"
            custom string content = """USD Composition is the process of combining multiple layers and references into a single resolved stage. Composition arcs (LIVRPS) define how opinions from different sources combine. The result is a flattened view where each attribute has exactly one resolved value. Composition is lazy - only accessed prims are fully composed."""
            custom string summary = "Process of combining USD layers and references into a single resolved stage"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/LIVRPS"]
            custom string[] enables = ["/Knowledge/USD/Stage", "/Knowledge/USD/LayerStack"]
            custom string[] related_to = ["/Knowledge/USD/Opinion", "/Knowledge/USD/Reference"]
            custom string teaching_altitude = "15000ft"
            custom string[] key_concepts = ["Layer combination", "Opinion resolution", "Lazy evaluation"]
            custom string[] triggers = ["composition", "compose", "layer combination", "how usd combines"]
        }

        def "Prim" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Prim"
            custom string content = """A Prim (primitive) is the fundamental unit in USD's scene hierarchy. Prims have a path, type (schema), and contain attributes, relationships, and metadata. Prims form a tree structure with parent-child relationships. Common prim types include Xform, Mesh, Scope, and custom schema types."""
            custom string summary = "Fundamental unit in USD scene hierarchy containing attributes and relationships"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = []
            custom string[] enables = ["/Knowledge/USD/Attribute", "/Knowledge/USD/Relationship", "/Knowledge/USD/Schema"]
            custom string[] related_to = ["/Knowledge/USD/Def", "/Knowledge/USD/Over", "/Knowledge/USD/Class"]
            custom string teaching_altitude = "Ground"
            custom string[] key_concepts = ["Scene hierarchy unit", "Contains attributes", "Has path and type"]
            custom string[] triggers = ["prim", "primitive", "usd prim", "what is a prim"]
        }

        def "Attribute" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Attribute"
            custom string content = """Attributes store typed data values on prims. They have a name, type (int, float, string, etc.), and optional time samples for animation. Attributes can be custom (user-defined) or part of a schema. Value resolution follows composition rules - the strongest opinion wins."""
            custom string summary = "Typed data values stored on prims, supporting animation via time samples"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Prim"]
            custom string[] enables = ["/Knowledge/USD/TimeSamples", "/Knowledge/USD/Opinion"]
            custom string[] related_to = ["/Knowledge/USD/Relationship", "/Knowledge/USD/Schema"]
            custom string teaching_altitude = "Ground"
            custom string[] key_concepts = ["Typed values", "Time samples", "Opinion resolution"]
            custom string[] triggers = ["attribute", "usd attribute", "prim attribute", "attr"]
        }

        def "Relationship" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Relationship"
            custom string content = """Relationships are connections between prims, storing lists of paths to target prims. Unlike attributes, relationships point to other prims rather than holding values. Common uses include material bindings, collection membership, and skeletal bindings. Relationships compose by list-editing (append, prepend, delete)."""
            custom string summary = "Connections between prims storing paths to target prims"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Prim"]
            custom string[] enables = ["/Knowledge/USD/MaterialBinding"]
            custom string[] related_to = ["/Knowledge/USD/Attribute", "/Knowledge/USD/Collection"]
            custom string teaching_altitude = "Ground"
            custom string[] key_concepts = ["Prim connections", "Path targets", "List editing"]
            custom string[] triggers = ["relationship", "usd relationship", "prim connection", "rel"]
        }

        def "Stage" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Stage"
            custom string content = """The Stage is the composed view of a USD scene. It presents a single unified prim hierarchy from potentially many layers. The stage handles composition, provides the API for traversal and editing, and manages the layer stack. Opening a stage is the entry point for USD operations."""
            custom string summary = "Composed view of USD scene presenting unified prim hierarchy from layers"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Composition", "/Knowledge/USD/LayerStack"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/DefaultPrim", "/Knowledge/USD/RootLayer"]
            custom string teaching_altitude = "15000ft"
            custom string[] key_concepts = ["Composed view", "Entry point", "Layer management"]
            custom string[] triggers = ["stage", "usd stage", "open stage", "Usd.Stage"]
        }

        def "LayerStack" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/LayerStack"
            custom string content = """The LayerStack is the ordered list of layers that contribute to a stage. The root layer is at the top, with sublayers below. Stronger layers override weaker ones within the stack. Session layers sit above all others for non-destructive edits. Each layer can itself reference other layers."""
            custom string summary = "Ordered list of layers contributing to a stage, with override priority"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Composition"]
            custom string[] enables = ["/Knowledge/USD/Opinion"]
            custom string[] related_to = ["/Knowledge/USD/Stage", "/Knowledge/USD/Sublayer"]
            custom string teaching_altitude = "15000ft"
            custom string[] key_concepts = ["Layer ordering", "Override priority", "Session layer"]
            custom string[] triggers = ["layer stack", "layerstack", "sublayers", "layer order"]
        }

        def "Variant" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Variant"
            custom string content = """A Variant is a named alternative within a VariantSet. It contains opinions that apply when that variant is selected. Common uses include LOD levels, material variations, and regional differences. Only one variant per set is active at a time."""
            custom string summary = "Named alternative within a VariantSet containing conditional opinions"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/VariantSet"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/LIVRPS"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["Named option", "Conditional opinions", "Single selection"]
            custom string[] triggers = ["variant", "usd variant", "variant selection"]
        }

        def "VariantSet" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/VariantSet"
            custom string content = """A VariantSet is a collection of named variants on a prim. It allows switching between predefined configurations without external references. VariantSets are part of the composition system (the V in LIVRPS) and affect all child prims. Selection can be authored in layers or set at runtime."""
            custom string summary = "Collection of named variants enabling configuration switching on a prim"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Prim", "/Knowledge/USD/LIVRPS"]
            custom string[] enables = ["/Knowledge/USD/Variant"]
            custom string[] related_to = ["/Knowledge/USD/Composition"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["Variant collection", "Configuration switching", "Composition arc"]
            custom string[] triggers = ["variantset", "variant set", "variantsets"]
        }

        def "Reference" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Reference"
            custom string content = """A Reference is a composition arc that brings content from another layer into the current prim. The referenced content appears as if authored locally but can be overridden. References are loaded immediately (unlike payloads). Multiple references can target the same prim, composing via list editing."""
            custom string summary = "Composition arc bringing content from another layer, loaded immediately"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/LIVRPS", "/Knowledge/USD/Composition"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Payload", "/Knowledge/USD/Inherits"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["External content", "Immediate loading", "Composition arc"]
            custom string[] triggers = ["reference", "usd reference", "references", "ref"]
        }

        def "Payload" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Payload"
            custom string content = """A Payload is like a reference but supports deferred loading. Payloads can be unloaded to reduce memory, making them ideal for heavy assets. The stage controls which payloads are loaded via load rules. Payloads are weaker than references in composition (LIVRPS)."""
            custom string summary = "Deferred-loading composition arc for heavy assets, can be unloaded"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/LIVRPS", "/Knowledge/USD/Reference"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Stage", "/Knowledge/USD/LoadRules"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["Deferred loading", "Memory management", "Load rules"]
            custom string[] triggers = ["payload", "usd payload", "payloads", "lazy load"]
        }

        def "Inherits" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Inherits"
            custom string content = """Inherits is a composition arc for sharing opinions from a class prim. Inherited content acts as a fallback - local opinions override inherited ones. Classes are typically defined with 'class' keyword and contain shared defaults. Inherits is the I in LIVRPS, stronger than variants."""
            custom string summary = "Composition arc for inheriting opinions from class prims as fallbacks"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/LIVRPS", "/Knowledge/USD/Class"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Specializes", "/Knowledge/USD/Reference"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["Class inheritance", "Shared defaults", "Fallback values"]
            custom string[] triggers = ["inherits", "usd inherits", "inheritance", "class inherit"]
        }

        def "Specializes" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Specializes"
            custom string content = """Specializes is the weakest composition arc, providing base definitions that everything else overrides. It's used for 'is-a' relationships where a prim specializes a base type. Unlike inherits, specialized content is always the weakest opinion, ensuring derived types can fully customize."""
            custom string summary = "Weakest composition arc for base definitions, always overridden"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/LIVRPS"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Inherits", "/Knowledge/USD/Schema"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["Base definitions", "Weakest arc", "Is-a relationships"]
            custom string[] triggers = ["specializes", "usd specializes", "specialize"]
        }

        def "Schema" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Schema"
            custom string content = """Schemas define prim types and their expected attributes/relationships. IsA schemas (like UsdGeomMesh) define typed prims. Applied API schemas (like UsdShadeMaterialBindingAPI) add capabilities to any prim. Schemas are defined in USD plugin files and provide fallback values."""
            custom string summary = "Type definitions specifying expected attributes and relationships for prims"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Prim", "/Knowledge/USD/Attribute"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Kind", "/Knowledge/USD/Purpose"]
            custom string teaching_altitude = "15000ft"
            custom string[] key_concepts = ["Type definitions", "IsA vs Applied", "Fallback values"]
            custom string[] triggers = ["schema", "usd schema", "prim type", "apiSchema"]
        }

        def "Kind" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Kind"
            custom string content = """Kind is metadata classifying prims for pipeline purposes. Standard kinds include 'model' (root of asset), 'component' (leaf model), 'group' (collection), and 'assembly' (set of models). Kind enables model hierarchy traversal without loading full geometry."""
            custom string summary = "Pipeline metadata classifying prims as model, component, group, or assembly"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx", "pipeline"]
            custom string[] requires = ["/Knowledge/USD/Prim"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Purpose", "/Knowledge/USD/Schema"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["Model classification", "Hierarchy traversal", "Pipeline metadata"]
            custom string[] triggers = ["kind", "usd kind", "model kind", "component kind"]
        }

        def "Purpose" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Purpose"
            custom string content = """Purpose controls visibility for different contexts: 'default' (always visible), 'render' (final renders only), 'proxy' (viewport proxy), 'guide' (guides/helpers). Renderers and viewers filter by purpose. Setting purpose on parent affects all descendants."""
            custom string summary = "Visibility control for render, proxy, or guide contexts"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Prim"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Kind", "/Knowledge/USD/Visibility"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["Visibility context", "Render vs proxy", "Inheritance"]
            custom string[] triggers = ["purpose", "usd purpose", "render purpose", "proxy purpose"]
        }

        def "Opinion" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Opinion"
            custom string content = """An Opinion is a value authored for an attribute in a specific layer. Multiple layers can have opinions for the same attribute - composition determines which wins. The strongest opinion (per LIVRPS) becomes the resolved value. 'No opinion' differs from explicit default."""
            custom string summary = "Authored value for an attribute in a layer, resolved via composition"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Attribute", "/Knowledge/USD/LIVRPS"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/LayerStack", "/Knowledge/USD/Composition"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["Authored value", "Layer source", "Resolution"]
            custom string[] triggers = ["opinion", "usd opinion", "authored value", "which value"]
        }

        def "DefaultPrim" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/DefaultPrim"
            custom string content = """DefaultPrim is layer metadata specifying which prim to use when the layer is referenced without an explicit target path. It's essential for asset layers - when you reference asset.usd, the defaultPrim determines what gets brought in. Set via layer.defaultPrim or in file header."""
            custom string summary = "Layer metadata specifying which prim to use when referenced without path"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx", "pipeline"]
            custom string[] requires = ["/Knowledge/USD/Reference", "/Knowledge/USD/Payload"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Stage", "/Knowledge/USD/AssetPath"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["Reference target", "Asset root", "Layer metadata"]
            custom string[] triggers = ["defaultprim", "default prim", "asset root"]
        }

        def "Xform" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Xform"
            custom string content = """UsdGeomXform is a transformable prim type providing 3D transforms. Transforms are defined via xformOps - an ordered list of operations (translate, rotate, scale, matrix). The xformOpOrder attribute controls operation order. Xform is the base for most geometric prims."""
            custom string summary = "Transformable prim type with ordered transform operations"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Prim", "/Knowledge/USD/Schema"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Scope", "/Knowledge/USD/Mesh"]
            custom string teaching_altitude = "Ground"
            custom string[] key_concepts = ["Transform operations", "xformOpOrder", "Geometric base"]
            custom string[] triggers = ["xform", "usdgeomxform", "transform prim", "xformOp"]
        }

        def "Scope" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Scope"
            custom string content = """UsdGeomScope is a grouping prim with no transform or geometry. It's used purely for organization - grouping related prims under a common parent. Scope is lightweight compared to Xform when transforms aren't needed. Common for organizing materials, lights, or logical groups."""
            custom string summary = "Lightweight grouping prim for organization without transform"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Prim"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Xform", "/Knowledge/USD/Kind"]
            custom string teaching_altitude = "Ground"
            custom string[] key_concepts = ["Grouping", "No transform", "Organization"]
            custom string[] triggers = ["scope", "usdgeomscope", "group prim", "organize"]
        }

        def "Def" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Def"
            custom string content = """'def' is the USD keyword for defining a concrete prim that exists in the composed stage. A def creates a prim spec that contributes to the final scene graph. This differs from 'over' (override only) and 'class' (abstract template). Most prims are created with def."""
            custom string summary = "USD keyword for defining concrete prims in the scene graph"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Prim"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Over", "/Knowledge/USD/Class"]
            custom string teaching_altitude = "Ground"
            custom string[] key_concepts = ["Concrete prim", "Scene graph entry", "Definition"]
            custom string[] triggers = ["def keyword", "usd def", "define prim"]
        }

        def "Over" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Over"
            custom string content = """'over' is the USD keyword for overriding an existing prim without defining it. Over specs only contribute opinions if the prim exists from elsewhere. This is used in override layers to modify referenced content without duplicating structure. Over alone doesn't create a prim."""
            custom string summary = "USD keyword for overriding existing prims without defining them"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Prim", "/Knowledge/USD/Composition"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Def", "/Knowledge/USD/Opinion"]
            custom string teaching_altitude = "Ground"
            custom string[] key_concepts = ["Override only", "No definition", "Layer edits"]
            custom string[] triggers = ["over keyword", "usd over", "override prim"]
        }

        def "Class" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/Class"
            custom string content = """'class' is the USD keyword for defining an abstract prim template. Class prims don't appear in the composed stage but can be inherited from. They provide shared defaults for multiple prims. Classes are typically defined at root level (/_class_MyClass) for inheritance."""
            custom string summary = "USD keyword for abstract prim templates used with inherits"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx"]
            custom string[] requires = ["/Knowledge/USD/Prim", "/Knowledge/USD/Inherits"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Def", "/Knowledge/USD/Over"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["Abstract template", "Inheritance source", "Shared defaults"]
            custom string[] triggers = ["class keyword", "usd class", "class prim", "template"]
        }

        def "TimeSamples" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/USD/TimeSamples"
            custom string content = """TimeSamples store animated attribute values keyed to time codes. Each sample is a (time, value) pair. USD interpolates between samples (linear for most types). Time samples are stored efficiently - only changes are recorded. Default values apply when no samples exist."""
            custom string summary = "Animated attribute values keyed to time codes with interpolation"
            custom float confidence = 0.95
            custom string provenance = "pixar_usd_docs"
            custom string[] domains = ["usd", "vfx", "animation"]
            custom string[] requires = ["/Knowledge/USD/Attribute"]
            custom string[] enables = []
            custom string[] related_to = ["/Knowledge/USD/Stage", "/Knowledge/USD/Opinion"]
            custom string teaching_altitude = "5000ft"
            custom string[] key_concepts = ["Animation keys", "Interpolation", "Efficient storage"]
            custom string[] triggers = ["timesamples", "time samples", "animation usd", "keyframes"]
        }
    }

    # ═══════════════════════════════════════════════════════════════════
    # HOUDINI CONCEPTS (25 prims)
    # ═══════════════════════════════════════════════════════════════════

    def "Houdini" {
        def "LOPs" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/Houdini/LOPs"
            custom string content = """LOPs (Layout Operators) is Houdini's USD-native context for scene layout and lighting. LOPs nodes operate on USD stages, creating prims, setting attributes, and managing composition. The LOP network builds a procedural USD pipeline within Houdini."""
            custom string summary = "Houdini's USD-native context for scene layout and lighting"
            custom float confidence = 0.95
            custom string provenance = "sidefx_docs"
            custom string[] domains = ["houdini", "vfx", "usd"]
            custom string[] requires = []
            custom string[] enables = ["/Knowledge/Houdini/SolarisLighting", "/Knowledge/Houdini/USD_ROP"]
            custom string[] related_to = ["/Knowledge/Houdini/SOPs", "/Knowledge/USD/Stage"]
            custom string teaching_altitude = "15000ft"
            custom string[] key_concepts = ["USD context", "Scene layout", "Procedural USD"]
            custom string[] triggers = ["lops", "layout operators", "solaris", "houdini usd"]
        }

        def "SOPs" (
            prepend apiSchemas = ["KnowledgePrimAPI"]
        )
        {
            custom string canonical_path = "/Knowledge/Houdini/SOPs"
            custom string content = """SOPs (Surface Operators) is Houdini's geometry context for modeling, procedural geometry, and simulation setup. SOPs operate on geometry (points, primitives, vertices). The SOP context is Houdini's most used, with hundreds of nodes for geometry manipulation."""
