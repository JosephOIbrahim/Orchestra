# Framework Orchestrator Environment Configuration
# Copy this file to .env and customize for your environment
#
# SECURITY: Never commit .env files with real secrets to version control
# For production, use Kubernetes Secrets, HashiCorp Vault, or cloud secret managers

# =============================================================================
# Core Configuration
# =============================================================================

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FORMAT=json
# Options: json, text

# =============================================================================
# Agent Configuration
# =============================================================================

# Maximum number of agents running in parallel
MAX_PARALLEL_AGENTS=3

# Default timeout for agent execution (seconds)
DEFAULT_TIMEOUT=30

# =============================================================================
# Resilience Configuration
# =============================================================================

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Number of failures before opening circuit

CIRCUIT_BREAKER_RESET_TIMEOUT=60
# Seconds before attempting to close circuit

# Retry
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
# Base delay in seconds

RETRY_JITTER=0.1
# Jitter factor (0.0-1.0) to prevent thundering herd

# =============================================================================
# Rate Limiting
# =============================================================================

RATE_LIMIT_REQUESTS=100
# Maximum requests per window

RATE_LIMIT_WINDOW=60
# Window size in seconds

# =============================================================================
# Bulkhead (Agent Isolation)
# =============================================================================

BULKHEAD_MAX_CONCURRENT=5
# Maximum concurrent executions across all agents

BULKHEAD_QUEUE_SIZE=20
# Maximum queued requests per agent

# =============================================================================
# Checkpointing
# =============================================================================

ENABLE_CHECKPOINTS=true
CHECKPOINT_DIR=/data/checkpoints
# Directory for checkpoint files (must be writable)

# =============================================================================
# Domain Configuration
# =============================================================================

DOMAINS_PATH=/config/domains
# Path to domain configuration JSON files

# =============================================================================
# Observability
# =============================================================================

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_ENDPOINT=
# Example: http://otel-collector:4317

# Metrics endpoint
METRICS_ENABLED=true
METRICS_PORT=8080

# =============================================================================
# HTTP API
# =============================================================================

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# =============================================================================
# Secrets (DO NOT COMMIT REAL VALUES)
# =============================================================================

# For production, use one of:
# - Kubernetes Secrets mounted as files
# - HashiCorp Vault with agent injection
# - AWS Secrets Manager / GCP Secret Manager / Azure Key Vault
# - Environment variables injected by secure CI/CD

# Example placeholders (replace with your secret management):
# API_KEY=${VAULT:secret/data/framework-orchestrator#api_key}
# DATABASE_URL=${AWS_SECRETS:framework-orchestrator/database-url}

# =============================================================================
# Development Only (DO NOT USE IN PRODUCTION)
# =============================================================================

# DEBUG_MODE=false
# Enables additional debug logging and endpoints

# DISABLE_AUTH=false
# Disables authentication (NEVER in production)

# =============================================================================
# Notes
# =============================================================================
#
# 1. All values shown are defaults - only override what you need to change
#
# 2. For Kubernetes deployment, prefer ConfigMaps for non-sensitive config
#    and Secrets for sensitive values
#
# 3. Environment variables take precedence over config files
#
# 4. See docs/CONFIGURATION.md for full reference
#
# 5. See docs/SECURITY_CHECKLIST.md before production deployment
