      },
      "title": "",
      "type": "text"
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 2 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(framework_orchestrator_orchestration_total[5m]))",
          "legendFormat": "Orchestrations/sec"
        }
      ],
      "title": "Orchestration Rate",
      "type": "stat"
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 2 },
      "id": 3,
      "options": {
        "colorMode": "value",
