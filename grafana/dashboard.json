        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.05 },
            { "color": "red", "value": 0.1 }
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(framework_orchestrator_orchestration_errors_total[5m])) / sum(rate(framework_orchestrator_orchestration_total[5m]))",
          "legendFormat": "Error Rate"
        }
      ],
      "title": "Error Rate",
      "type": "stat"
